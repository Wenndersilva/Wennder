# Copie para .env (não vai para o Git) e preencha no PC que roda o monitor.
# Destinatários: CEO + financeiro, separados por vírgula.
ALERTA_PARA=email-do-wennder@...,financeiro@...

# Conta que envia os alertas (recomendado: conta própria tipo alertas@, com senha de app do Gmail/Google Workspace)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=alertas@...
SMTP_PASS=senha-de-app-de-16-letras
